# ============================================================
# LOKAL UDVIKLING (din PC) — filen .env committes ALDRIG til git
# ============================================================

# Kun nødvendig hvis du kører projektet lokalt med: .\run_local.ps1
# OPENAI_API_KEY=sk-din-noegle-her
# XAI_API_KEY=xai-din-noegle-her

# Kun nødvendig hvis du deployer til server med: .\run_deploy.ps1
# SUDO_PASS=din-sudo-adgangskode

# Valgfrit — sættes automatisk af run_local.ps1
# ANALYSE_LOGS_DIR=data/analyse_logs
# LEGAL_SOURCES_DIR=data/legal_sources
# FRONTEND_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
# JAILA_DJV_EDITION=2026-2
# Tom JAILA_DJV_EDITION slår DJV-udgavefilteret fra. Love skal have corpus != djv.
# JAILA_SKAT_DATABASE_URL=postgresql://jaila:jaila@127.0.0.1:5433/jaila_skat
# JAILA_SKAT_RETRIEVAL_ENABLED=true
# Aktivér først når DSN bruger en login-rolle med jaila_app (kun SELECT/EXECUTE).
# Live søge-testside (POST /api/skat/search). Tænder ikke chat-retrieval.
# JAILA_SKAT_SEARCH_API=true
# JAILA_SKAT_RAW_HTML_DIR=data/skat_info

# ============================================================
# PRODUKTION (serveren) — adskilt fra denne fil!
# ============================================================
# På serveren ligger API-nøglen i:
#   /etc/jaila-backend.env
# Den fil læses af systemd-servicen jaila-backend.
# Deploy-scriptet (run_deploy.ps1) uploader KUN kode — ikke .env.
