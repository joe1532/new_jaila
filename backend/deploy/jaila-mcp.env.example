# Installér som /etc/jaila-mcp.env med ejer root:root og mode 600.
# Brug helst en separat OpenAI-projektnøgle med eget budget til MCP.
OPENAI_API_KEY=sk-proj-erstat-mig

# Generér eksempelvis med: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_TOKEN=erstat-med-et-langt-tilfaeldigt-token
