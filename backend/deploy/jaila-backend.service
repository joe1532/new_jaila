[Unit]
Description=JAILA Backend API (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/jaila_backend
EnvironmentFile=/etc/jaila-backend.env
ExecStart=/opt/jaila_backend/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
